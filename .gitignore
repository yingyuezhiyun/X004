# Keep only these three top-level directories tracked
/*
!/BootLoader/
!/H743VE/
!/wpfApp/
!/.gitignore
!/.gitattributes
# Mono-repo root .gitignore
# Build folders
**/Debug/
**/Release/
**/build/

# Keil/MDK
MDK-ARM/**/Debug/
MDK-ARM/**/Objects/

# RTE and generated
**/RTE/

# Common object and binary files
**/*.o
**/*.obj
**/*.axf
**/*.elf
**/*.hex
**/*.bin
**/*.map
**/*.lst
**/*.log
**/*.dep

# .NET / WPF build outputs
**/bin/
**/obj/
**/*.user
**/*.suo
**/*.cache
**/*.nupkg

# Visual Studio / VSCode
/.vs/
**/.vs/
/.vscode/
**/.vscode/
/.vscode/

# Temporary and editor files
*.swp
*.swo
*.tmp

# Visual Studio files
*.suo
*.user
*.userosscache
*.sdf
*.opendb

# .NET / WPF build outputs
**/bin/
**/obj/

# VS index/cache files
**/*.vsidx

# Exclude big generated directories
.vs/
/.vscode/


# Installer / packaging outputs
**/*.msi
**/*.exe
**/*.dll
**/*.pdb

# Git LFS metadata
.gitattributes

# Logs
*.log

# Local IDE / debug configs
DebugConfig/



# Additional patterns to ignore MDK build outputs and backups
**/*.d
**/*.crf
**/*.lnp
**/*.htm
**/*.sct
**/*.Bak
**/*.iex
**/*.db
**/back/
**/build_logs/
# Editor/IDE caches already covered but reinforce
**/.vs/**
**/.vscode/**
**/bin/**
**/obj/**

