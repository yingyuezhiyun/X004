<UserControl
    x:Class="wpfApp.Views.PLDMainView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:wpfApp.Common.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ext="clr-namespace:wpfApp.Extensions"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:wpfApp.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:validrule="clr-namespace:wpfApp.Common.ValidationRules"
    d:DesignHeight="720"
    d:DesignWidth="1100"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <converters:PrefixConverter x:Key="PrefixConverter" />
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition />
                <ColumnDefinition Width="410" />
                <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>


            <materialDesign:Card
                Grid.Row="0"
                Margin="5"
                FontSize="14"
                UniformCornerRadius="20">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <DockPanel Margin="0,10,0,0" LastChildFill="False">
                            <materialDesign:PackIcon
                                Width="20"
                                Height="20"
                                Margin="10,0,10,0"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                Kind="SerialPort" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="16"
                                Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                Text="连接设置" />
                        </DockPanel>
                        <StackPanel
                            Margin="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            Orientation="Horizontal">
                            <TextBlock
                                Margin="25,0,25,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                FontWeight="Bold"
                                Text="端口号" />
                            <ComboBox
                                MinWidth="72"
                                Margin="25,0,25,0"
                                VerticalAlignment="Center"
                                ItemsSource="{Binding PortName}"
                                SelectedItem="{Binding DevPortName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                <ComboBox.Style>
                                    <Style BasedOn="{StaticResource {x:Type ComboBox}}" TargetType="ComboBox">
                                        <Setter Property="IsEnabled" Value="True" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DeviceIsOpen}" Value="True">
                                                <Setter Property="IsEnabled" Value="False" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ComboBox.Style>
                            </ComboBox>
                        </StackPanel>

                        <UniformGrid Margin="0,10,0,0" Columns="2">
                            <Button
                                Height="25"
                                Margin="5,0,5,0"
                                Command="{Binding ExecuteCommand}"
                                CommandParameter="扫描端口"
                                Content="扫描端口"
                                Cursor="Hand">
                                <Button.Style>
                                    <Style BasedOn="{StaticResource MaterialDesignRaisedButton}" TargetType="Button">
                                        <Setter Property="IsEnabled" Value="True" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DeviceIsOpen}" Value="True">
                                                <Setter Property="IsEnabled" Value="False" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button
                                Height="25"
                                Margin="5,0,5,0"
                                Command="{Binding ExecuteCommand}"
                                CommandParameter="连接设备">
                                <Button.Style>
                                    <Style BasedOn="{StaticResource MaterialDesignRaisedButton}" TargetType="Button">
                                        <Setter Property="Content" Value="连接设备" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DeviceIsOpen, UpdateSourceTrigger=PropertyChanged}" Value="True">
                                                <Setter Property="Content" Value="断开连接" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </UniformGrid>
                        <Border Margin="5,10,5,5" Style="{StaticResource HorizontalDividerBorder}" />


                    </StackPanel>

                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <DockPanel Margin="0,10,0,0" LastChildFill="False">
                                <materialDesign:PackIcon
                                    Width="20"
                                    Height="20"
                                    Margin="10,0,10,0"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                    Kind="CogSync" />

                                <TextBlock
                                    Margin="0,0,10,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="16"
                                    Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                    Text="工作状态" />
                            </DockPanel>

                        </StackPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl Margin="10,0,10,0" ItemsSource="{Binding MeasureParams.StatusList}">
                                <!--<ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel MinWidth="280" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>-->
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="25,20,0,0" Orientation="Horizontal">
                                            <TextBlock
                                                MinWidth="50"
                                                Margin="0,0,20,0"
                                                HorizontalAlignment="Right"
                                                FontSize="16"
                                                Text="{Binding Name}"
                                                TextAlignment="Right" />
                                            <TextBlock
                                                HorizontalAlignment="Left"
                                                FontSize="16"
                                                Text="{Binding Value}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                    <StackPanel Grid.Row="2">
                        <Border Margin="5,15,5,5" Style="{StaticResource HorizontalDividerBorder}" />
                        <UniformGrid
                            Margin="0,10,0,20"
                            Columns="2"
                            IsEnabled="{Binding DeviceIsOpen}">
                            <Button
                                Height="25"
                                Margin="5,0,5,0"
                                materialDesign:ButtonProgressAssist.IsIndeterminate="True"
                                materialDesign:ButtonProgressAssist.IsIndicatorVisible="{Binding IsUpdatePara}"
                                materialDesign:ButtonProgressAssist.Value="-1"
                                Command="{Binding ExecuteCommand}"
                                CommandParameter="参数更新"
                                Cursor="Hand">
                                <Button.Style>
                                    <Style BasedOn="{StaticResource MaterialDesignRaisedButton}" TargetType="Button">
                                        <Setter Property="Content" Value="参数更新" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsUpdatePara}" Value="True">
                                                <Setter Property="Content" Value="参数更新中..." />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button
                                Height="25"
                                Margin="5,0,5,0"
                                Command="{Binding ExecuteCommand}"
                                CommandParameter="参数固化"
                                Content="参数固化" />
                        </UniformGrid>
                    </StackPanel>



                </Grid>
            </materialDesign:Card>


            <materialDesign:Card
                Grid.Column="1"
                Margin="5"
                FontSize="16"
                UniformCornerRadius="20">
                <!--<ScrollViewer VerticalScrollBarVisibility="Auto">-->
                <StackPanel>
                    <ItemsControl Margin="10,0,10,0" ItemsSource="{Binding MeasureParams.MeasureParamsShowList}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Vertical">
                                    <DockPanel Margin="0,10,0,0" LastChildFill="False">
                                        <materialDesign:PackIcon
                                            Width="20"
                                            Height="20"
                                            Margin="10,0,10,0"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                            Kind="{Binding Icon}" />
                                        <TextBlock
                                            Margin="0,0,10,0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="16"
                                            Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                            Text="{Binding Tile}" />
                                    </DockPanel>

                                    <ItemsControl ItemsSource="{Binding Params}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Margin="15,0,0,0" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="5,5,20,5" Orientation="Horizontal">
                                                    <TextBlock MinWidth="50" Text="{Binding Name}" />
                                                    <TextBlock MinWidth="45" Text="{Binding Value}" />
                                                    <TextBlock
                                                        MinWidth="15"
                                                        Margin="5,0,0,0"
                                                        Text="{Binding Unit}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Border Margin="5,10,5,5" Style="{StaticResource HorizontalDividerBorder}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!--<StackPanel Orientation="Vertical">
                        <DockPanel Margin="0,10,0,0" LastChildFill="False">
                            <materialDesign:PackIcon
                                Width="20"
                                Height="20"
                                Margin="10,0,10,0"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                Kind="CogSync" />
                            <TextBlock
                                Margin="0,0,10,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="16"
                                Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                Text="LD1测量参数" />
                        </DockPanel>
                        <WrapPanel Margin="15,0,0,0">
                            <StackPanel Margin="5,5,20,5" Orientation="Horizontal">
                                <TextBlock MinWidth="50" Text="温度:" />
                                <TextBlock
                                    MinWidth="45"
                                    Margin="0,0,0,0"
                                    Text="25.0" />
                                <TextBlock Margin="5,0,0,0" Text="℃" />
                            </StackPanel>
                        </WrapPanel>
                        <Border Margin="5,10,5,5" Style="{StaticResource HorizontalDividerBorder}" />
                    </StackPanel>-->

                </StackPanel>
                <!--</ScrollViewer>-->
            </materialDesign:Card>


            <materialDesign:Card
                Grid.Column="2"
                Margin="5"
                FontSize="16"
                UniformCornerRadius="20">

                <TabControl
                    Margin="10"
                    materialDesign:NavigationRailAssist.SelectionCornerRadius="10"
                    materialDesign:NavigationRailAssist.ShowSelectionBackground="True"
                    Background="Transparent"
                    FontSize="14"
                    Style="{StaticResource MaterialDesignNavigationRailTabControl}"
                    TabStripPlacement="Right">
                    <TabItem Width="40">
                        <TabItem.Header>
                            <TextBlock
                                Margin="0"
                                HorizontalAlignment="Center"
                                RenderTransformOrigin=".5,.5"
                                Text="设备控制">
                                <TextBlock.LayoutTransform>
                                    <RotateTransform Angle="90" />
                                </TextBlock.LayoutTransform>
                            </TextBlock>
                        </TabItem.Header>
                        <Grid Margin="0,10,10,0" HorizontalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <DockPanel LastChildFill="False">
                                <materialDesign:PackIcon
                                    Width="20"
                                    Height="20"
                                    Margin="10,0,10,0"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                    Kind="CogSync" />

                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="16"
                                    Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                    Text="设备控制" />
                            </DockPanel>

                            <ScrollViewer
                                Grid.RowSpan="2"
                                Margin="0,30,0,0"
                                VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="0" IsEnabled="{Binding DeviceIsOpen}">



                                    <StackPanel
                                        Margin="5,10,0,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">
                                        <TextBlock
                                            MinWidth="100"
                                            VerticalAlignment="Center"
                                            FontWeight="Bold"
                                            Text="调制模式" />
                                        <TextBlock
                                            MinWidth="50"
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center"
                                            Text="{Binding SettingParamsToShow.Mode}" />
                                        <ComboBox
                                            Width="70"
                                            Margin="10,0,0,0"
                                            HorizontalAlignment="Center"
                                            ItemsSource="{Binding ModeList}"
                                            SelectedItem="{Binding SettingParams.Mode}" />
                                        <Button
                                            Height="25"
                                            Margin="10,0,0,0"
                                            Command="{Binding ExecuteCommand}"
                                            CommandParameter="设置模式"
                                            Content="设置"
                                            Cursor="Hand" />

                                    </StackPanel>



                                    <StackPanel
                                        Margin="5,10,0,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">
                                        <TextBlock
                                            MinWidth="100"
                                            VerticalAlignment="Center"
                                            FontWeight="Bold"
                                            Text="LD1电流" />
                                        <TextBlock
                                            MinWidth="50"
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center"
                                            Text="{Binding SettingParamsToShow.LDParams[0].Curr}" />
                                        <TextBox
                                            Width="70"
                                            Margin="10,0,0,0"
                                            materialDesign:TextFieldAssist.SuffixText="A"
                                            Text="{Binding SettingParams.LDParams[0].Curr}" />
                                        <Button
                                            Height="25"
                                            Margin="10,0,0,0"
                                            Command="{Binding ExecuteCommand}"
                                            CommandParameter="设置LD1电流"
                                            Content="设置"
                                            Cursor="Hand" />

                                    </StackPanel>



                                    <StackPanel
                                        Margin="5,10,0,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">
                                        <TextBlock
                                            MinWidth="100"
                                            VerticalAlignment="Center"
                                            FontWeight="Bold"
                                            Text="LD2电流" />
                                        <TextBlock
                                            MinWidth="50"
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center"
                                            Text="{Binding SettingParamsToShow.LDParams[1].Curr}" />
                                        <TextBox
                                            Width="70"
                                            Margin="10,0,0,0"
                                            materialDesign:TextFieldAssist.SuffixText="A"
                                            Text="{Binding SettingParams.LDParams[1].Curr}" />
                                        <Button
                                            Height="25"
                                            Margin="10,0,0,0"
                                            Command="{Binding ExecuteCommand}"
                                            CommandParameter="设置LD2电流"
                                            Content="设置"
                                            Cursor="Hand" />

                                    </StackPanel>

                                    <StackPanel
                                        Margin="5,10,0,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">
                                        <TextBlock
                                            MinWidth="100"
                                            VerticalAlignment="Center"
                                            FontWeight="Bold"
                                            Text="LD1温度" />
                                        <TextBlock
                                            MinWidth="50"
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center"
                                            Text="{Binding SettingParamsToShow.LDParams[0].Temp}" />
                                        <TextBox
                                            Width="70"
                                            Margin="10,0,0,0"
                                            materialDesign:TextFieldAssist.SuffixText="℃"
                                            Text="{Binding SettingParams.LDParams[0].Temp}" />
                                        <Button
                                            Height="25"
                                            Margin="10,0,0,0"
                                            Command="{Binding ExecuteCommand}"
                                            CommandParameter="设置LD1温度"
                                            Content="设置"
                                            Cursor="Hand" />

                                    </StackPanel>

                                    <StackPanel
                                        MinWidth="70"
                                        Margin="5,10,0,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">
                                        <TextBlock
                                            MinWidth="100"
                                            VerticalAlignment="Center"
                                            FontWeight="Bold"
                                            Text="LD2温度" />
                                        <TextBlock
                                            MinWidth="50"
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center"
                                            Text="{Binding SettingParamsToShow.LDParams[1].Temp}" />
                                        <TextBox
                                            Width="70"
                                            Margin="10,0,0,0"
                                            materialDesign:TextFieldAssist.SuffixText="℃"
                                            Text="{Binding SettingParams.LDParams[1].Temp}" />
                                        <Button
                                            Height="25"
                                            Margin="10,0,0,0"
                                            Command="{Binding ExecuteCommand}"
                                            CommandParameter="设置LD2温度"
                                            Content="设置"
                                            Cursor="Hand" />

                                    </StackPanel>

                                    <StackPanel
                                        Margin="5,10,0,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">
                                        <TextBlock
                                            MinWidth="100"
                                            VerticalAlignment="Center"
                                            FontWeight="Bold"
                                            Text="晶体1温度" />
                                        <TextBlock
                                            MinWidth="50"
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center"
                                            Text="{Binding SettingParamsToShow.TECParams[2].Temp}" />
                                        <TextBox
                                            Width="70"
                                            Margin="10,0,0,0"
                                            materialDesign:TextFieldAssist.SuffixText="℃"
                                            Text="{Binding SettingParams.TECParams[2].Temp}" />
                                        <Button
                                            Height="25"
                                            Margin="10,0,0,0"
                                            Command="{Binding ExecuteCommand}"
                                            CommandParameter="设置晶体1温度"
                                            Content="设置"
                                            Cursor="Hand" />

                                    </StackPanel>

                                    <StackPanel
                                        Margin="5,10,0,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">
                                        <TextBlock
                                            MinWidth="100"
                                            VerticalAlignment="Center"
                                            FontWeight="Bold"
                                            Text="晶体2温度" />
                                        <TextBlock
                                            MinWidth="50"
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center"
                                            Text="{Binding SettingParamsToShow.TECParams[3].Temp}" />
                                        <TextBox
                                            Width="70"
                                            Margin="10,0,0,0"
                                            materialDesign:TextFieldAssist.SuffixText="℃"
                                            Text="{Binding SettingParams.TECParams[3].Temp}" />
                                        <Button
                                            Height="25"
                                            Margin="10,0,0,0"
                                            Command="{Binding ExecuteCommand}"
                                            CommandParameter="设置晶体2温度"
                                            Content="设置"
                                            Cursor="Hand" />

                                    </StackPanel>

                                    <StackPanel
                                        Margin="5,10,0,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">
                                        <TextBlock
                                            MinWidth="100"
                                            VerticalAlignment="Center"
                                            FontWeight="Bold"
                                            Text="调Q开关" />
                                        <TextBlock
                                            MinWidth="50"
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center"
                                            Text="{Binding SettingParamsToShow.TQParams.IsWork}" />
                                        <ComboBox
                                            Width="70"
                                            Margin="10,0,0,0"
                                            HorizontalAlignment="Center"
                                            ItemsSource="{Binding ModeList}"
                                            SelectedItem="{Binding SettingParams.TQParams.IsWork}" />
                                        <Button
                                            Height="25"
                                            Margin="10,0,0,0"
                                            Command="{Binding ExecuteCommand}"
                                            CommandParameter="设置调Q开关"
                                            Content="设置"
                                            Cursor="Hand" />

                                    </StackPanel>



                                    <StackPanel
                                        Margin="5,10,0,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">
                                        <TextBlock
                                            MinWidth="100"
                                            VerticalAlignment="Center"
                                            FontWeight="Bold"
                                            Text="调Q时延" />
                                        <TextBlock
                                            MinWidth="50"
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center"
                                            Text="{Binding SettingParamsToShow.TQParams.Delay}" />
                                        <TextBox
                                            Width="70"
                                            Margin="10,0,0,0"
                                            materialDesign:TextFieldAssist.SuffixText="us"
                                            Text="{Binding SettingParams.TQParams.Delay}" />
                                        <Button
                                            Height="25"
                                            Margin="10,0,0,0"
                                            Command="{Binding ExecuteCommand}"
                                            CommandParameter="设置调Q时延"
                                            Content="设置"
                                            Cursor="Hand" />

                                    </StackPanel>





                                </StackPanel>
                            </ScrollViewer>

                            <StackPanel Grid.Row="2">
                                <Border Margin="5,25,5,5" Style="{StaticResource HorizontalDividerBorder}" />
                                <UniformGrid
                                    Margin="0,5,0,5"
                                    Columns="2"
                                    IsEnabled="{Binding DeviceIsOpen}"
                                    Rows="3">
                                    <Button
                                        Height="25"
                                        Margin="5"
                                        materialDesign:ButtonProgressAssist.IsIndeterminate="True"
                                        materialDesign:ButtonProgressAssist.IsIndicatorVisible="{Binding SettingParamsToShow.TECParams[0].IsWork}"
                                        materialDesign:ButtonProgressAssist.Value="-1"
                                        Command="{Binding ExecuteCommand}"
                                        CommandParameter="TEC1启动"
                                        Cursor="Hand">
                                        <Button.Style>
                                            <Style BasedOn="{StaticResource MaterialDesignRaisedButton}" TargetType="Button">
                                                <Setter Property="Content" Value="TEC1启动" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SettingParamsToShow.TECParams[0].IsWork}" Value="True">
                                                        <Setter Property="Content" Value="TEC1运行中" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button
                                        Height="25"
                                        Margin="5"
                                        materialDesign:ButtonProgressAssist.IsIndeterminate="True"
                                        materialDesign:ButtonProgressAssist.IsIndicatorVisible="{Binding SettingParamsToShow.TECParams[1].IsWork}"
                                        materialDesign:ButtonProgressAssist.Value="-1"
                                        Command="{Binding ExecuteCommand}"
                                        CommandParameter="TEC2启动">
                                        <Button.Style>
                                            <Style BasedOn="{StaticResource MaterialDesignRaisedButton}" TargetType="Button">
                                                <Setter Property="Content" Value="TEC2启动" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SettingParamsToShow.TECParams[1].IsWork}" Value="True">
                                                        <Setter Property="Content" Value="TEC2运行中" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>

                                    </Button>
                                    <Button
                                        Height="25"
                                        Margin="5"
                                        materialDesign:ButtonProgressAssist.IsIndeterminate="True"
                                        materialDesign:ButtonProgressAssist.IsIndicatorVisible="{Binding SettingParamsToShow.TECParams[2].IsWork}"
                                        materialDesign:ButtonProgressAssist.Value="-1"
                                        Command="{Binding ExecuteCommand}"
                                        CommandParameter="TEC3启动"
                                        Cursor="Hand">
                                        <Button.Style>
                                            <Style BasedOn="{StaticResource MaterialDesignRaisedButton}" TargetType="Button">
                                                <Setter Property="Content" Value="TEC3启动" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SettingParamsToShow.TECParams[2].IsWork}" Value="True">
                                                        <Setter Property="Content" Value="TEC3运行中" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button
                                        Height="25"
                                        Margin="5"
                                        materialDesign:ButtonProgressAssist.IsIndeterminate="True"
                                        materialDesign:ButtonProgressAssist.IsIndicatorVisible="{Binding SettingParamsToShow.TECParams[3].IsWork}"
                                        materialDesign:ButtonProgressAssist.Value="-1"
                                        Command="{Binding ExecuteCommand}"
                                        CommandParameter="TEC4启动">
                                        <Button.Style>
                                            <Style BasedOn="{StaticResource MaterialDesignRaisedButton}" TargetType="Button">
                                                <Setter Property="Content" Value="TEC4启动" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SettingParamsToShow.TECParams[3].IsWork}" Value="True">
                                                        <Setter Property="Content" Value="TEC4运行中" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>

                                    </Button>
                                    <Button
                                        Height="25"
                                        Margin="5"
                                        materialDesign:ButtonProgressAssist.IsIndeterminate="True"
                                        materialDesign:ButtonProgressAssist.IsIndicatorVisible="{Binding SettingParamsToShow.LDParams[0].IsWork}"
                                        materialDesign:ButtonProgressAssist.Value="-1"
                                        Command="{Binding ExecuteCommand}"
                                        CommandParameter="LD1启动"
                                        Cursor="Hand">
