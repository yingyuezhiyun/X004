<UserControl
    x:Class="wpfApp.Views.HomePageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:wpfApp.Common.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ext="clr-namespace:wpfApp.Extensions"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:wpfApp.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:validrule="clr-namespace:wpfApp.Common.ValidationRules"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.PopupBox.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="HorizontalDividerBorder" TargetType="{x:Type Border}">
                <Setter Property="Background" Value="{DynamicResource MaterialDesignDivider}" />
                <Setter Property="UseLayoutRounding" Value="True" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="Height" Value="1" />
            </Style>

            <Style
                x:Key="VerticalDividerBorder"
                BasedOn="{StaticResource HorizontalDividerBorder}"
                TargetType="{x:Type Border}">
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="Height" Value="Auto" />
                <Setter Property="Width" Value="1" />
            </Style>

            <Style x:Key="MyLisBoxItem" TargetType="{x:Type ListBoxItem}">
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,0,0,0" />
                <Setter Property="HorizontalContentAlignment" Value="{Binding HorizontalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" />
                <Setter Property="VerticalContentAlignment" Value="{Binding VerticalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" />
                <Setter Property="Background" Value="White" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <converters:NullableDecimalConverter x:Key="NullableDecimalConverter" />
        </ResourceDictionary>

    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <materialDesign:Card Margin="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <StackPanel>
                    <Expander HorizontalAlignment="Stretch">
                        <Expander.Header>
                            <DockPanel LastChildFill="False">
                                <TextBlock
                                    Margin="20,0,0,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="21"
                                    Text="配置" />

                                <materialDesign:PopupBox
                                    DockPanel.Dock="Right"
                                    PlacementMode="LeftAndAlignMiddles"
                                    Style="{StaticResource MaterialDesignMultiFloatingActionPopupBox}"
                                    UnfurlOrientation="Horizontal">
                                    <materialDesign:PopupBox.ToggleContent>
                                        <materialDesign:PackIcon Foreground="{Binding RelativeSource={RelativeSource AncestorType=materialDesign:PopupBox}, Path=Foreground}" Kind="WrenchOutline" />
                                    </materialDesign:PopupBox.ToggleContent>
                                    <StackPanel Orientation="Horizontal">
                                        <Button
                                            Command="{Binding ExecuteCommand}"
                                            CommandParameter="生成波形"
                                            ToolTip="生成波形">
                                            <materialDesign:PackIcon Kind="ChartLine" />
                                        </Button>

                                        <Button
                                            Command="{Binding ExecuteCommand}"
                                            CommandParameter="清空波形"
                                            ToolTip="清空波形">
                                            <materialDesign:PackIcon Kind="DeleteOutline" />
                                        </Button>
                                        <Button
                                            Command="{Binding ExecuteCommand}"
                                            CommandParameter="截图"
                                            ToolTip="截图">
                                            <Path
                                                Width="15"
                                                Height="15"
                                                Data="M437.76 430.08L170.496 79.36C156.672 61.44 159.232 35.84 176.64 20.48c16.896-14.848 42.496-12.8 56.832 4.096L512 344.576l278.528-320c14.848-16.896 39.936-18.432 56.832-4.096 17.408 14.848 19.968 40.448 6.144 58.88L586.24 430.08l165.888 190.976c92.672-33.792 196.096 4.096 245.248 89.6 49.152 85.504 29.184 194.048-47.104 256.512-76.288 62.464-186.368 61.44-260.608-3.072-74.752-64.512-92.16-173.056-40.96-257.536-1.536-1.536-3.072-3.584-4.096-5.12L512 527.872 437.76 430.08zM383.488 492.544l77.824 101.888L379.904 701.44c-1.536 1.536-2.56 3.584-4.096 5.12 50.688 84.48 33.792 193.024-40.96 257.536-74.752 64.512-184.832 65.536-260.608 3.072-76.288-62.464-95.744-171.008-47.104-256.512 49.152-85.504 152.576-123.392 245.248-89.6l111.104-128.512zM215.04 931.84c44.032-3.584 82.432-30.72 100.352-70.656 17.92-39.936 13.312-86.528-12.8-122.368-26.112-35.328-69.12-53.76-112.64-48.64-65.536 8.192-112.64 67.584-105.472 133.12 6.656 66.048 64.512 114.176 130.56 108.544z m593.92 0c43.52 5.632 86.528-13.312 112.64-48.64 26.112-35.328 30.72-81.92 12.8-121.856-17.92-39.936-56.32-67.072-100.352-70.656-66.048-5.632-124.416 42.496-131.072 108.032-6.656 65.536 40.448 124.928 105.984 133.12z m0 0"
                                                Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                                Stretch="Uniform" />
                                        </Button>
                                        <Button
                                            Command="{Binding ExecuteCommand}"
                                            CommandParameter="添加X轴辅助线"
                                            Content="X"
                                            ToolTip="X轴辅助线" />
                                        <Button
                                            Command="{Binding ExecuteCommand}"
                                            CommandParameter="添加Y轴辅助线"
                                            Content="Y"
                                            ToolTip="Y轴辅助线" />
                                        <Button
                                            Command="{Binding ExecuteCommand}"
                                            CommandParameter="删除辅助线"
                                            ToolTip="删除辅助线">
                                            <materialDesign:PackIcon Kind="Eraser" />
                                        </Button>
                                    </StackPanel>
                                </materialDesign:PopupBox>

                            </DockPanel>
                        </Expander.Header>
                        <StackPanel Orientation="Vertical" TextBlock.Foreground="{DynamicResource MaterialDesignBody}">
                            <Border Style="{StaticResource HorizontalDividerBorder}" />
                            <StackPanel Margin="5" Orientation="Horizontal">
                                <TextBlock
                                    Margin="20,0,10,0"
                                    VerticalAlignment="Center"
                                    Text="区间放大" />
                                <ToggleButton
                                    Margin="0,0,10,0"
                                    Command="{Binding ExecuteCommand}"
                                    CommandParameter="开启区间显示"
                                    IsChecked="{Binding IsScaleZoom}"
                                    Style="{StaticResource MaterialDesignSwitchToggleButton}">
                                    <i:Interaction.Triggers>
                                        <i:DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                                            <i:ChangePropertyAction
                                                PropertyName="Visibility"
                                                TargetObject="{Binding RelativeSource={RelativeSource AncestorType=StackPanel}, Path=Children[2]}"
                                                Value="Visible" />
                                        </i:DataTrigger>
                                        <!--<i:DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="False">
                                            <i:ChangePropertyAction
                                                PropertyName="Visibility"
                                                TargetObject="{Binding RelativeSource={RelativeSource AncestorType=StackPanel}, Path=Children[3]}"
                                                Value="Collapsed" />
                                        </i:DataTrigger>-->
                                    </i:Interaction.Triggers>
                                </ToggleButton>
                                <ComboBox
                                    Width="80"
                                    Margin="0,0,0,5"
                                    materialDesign:HintAssist.Hint="区间"
                                    materialDesign:TextFieldAssist.SuffixText="s"
                                    IsEditable="True"
                                    ItemsSource="{Binding ScaleZooms, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    SelectedItem="{Binding ScaleZoom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                                    Visibility="Collapsed">
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="SelectionChanged">
                                            <i:InvokeCommandAction Command="{Binding ExecuteCommand}" CommandParameter="区间显示改变" />
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>
                                </ComboBox>


                                <TextBox
                                    Margin="40,0,0,0"
                                    VerticalAlignment="Center"
                                    materialDesign:HintAssist.Hint="波形总长"
                                    Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                    Text="{Binding WaveLenth, Converter={StaticResource NullableDecimalConverter}}" />
                                <TextBox
                                    Margin="40,0,0,0"
                                    VerticalAlignment="Center"
                                    materialDesign:HintAssist.Hint="波特率"
                                    Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                    Text="{Binding BaudRate, Converter={StaticResource NullableDecimalConverter}}" />

                                <TextBox
                                    Margin="40,0,0,0"
                                    VerticalAlignment="Center"
                                    materialDesign:HintAssist.Hint="最大幅值"
                                    Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                    Text="{Binding MaxMaginitude, Converter={StaticResource NullableDecimalConverter}}" />
                                <TextBox
                                    Margin="40,0,0,0"
                                    VerticalAlignment="Center"
                                    materialDesign:HintAssist.Hint="幅值Tick"
                                    Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                    Text="{Binding MaginitudeTick, Converter={StaticResource NullableDecimalConverter}}" />


                            </StackPanel>
                            <Border Style="{StaticResource HorizontalDividerBorder}" />
                            <Expander HorizontalAlignment="Stretch">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="17"
                                            Text="主波形配置" />
                                        <ToggleButton
                                            Margin="20,0,0,0"
                                            IsChecked="{Binding MainWave.IsVisible}"
                                            Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                            ToolTip="显示波形">
                                            <materialDesign:PackIcon Kind="Pin" RenderTransformOrigin=".5,.5">
                                                <materialDesign:PackIcon.RenderTransform>
                                                    <RotateTransform Angle="45" />
                                                </materialDesign:PackIcon.RenderTransform>
                                            </materialDesign:PackIcon>
                                            <materialDesign:ToggleButtonAssist.OnContent>
                                                <materialDesign:PackIcon Kind="Pin" />
                                            </materialDesign:ToggleButtonAssist.OnContent>
                                        </ToggleButton>
                                    </StackPanel>
                                </Expander.Header>
                                <StackPanel Margin="5" Orientation="Horizontal">

                                    <TextBox
                                        MinWidth="50"
                                        Margin="20,0,20,0"
                                        VerticalAlignment="Center"
                                        materialDesign:HintAssist.Hint="频率"
                                        materialDesign:TextFieldAssist.SuffixText="Hz"
                                        Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                        Text="{Binding MainWave.Frequency, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NullableDecimalConverter}}" />

                                    <TextBlock
                                        Margin="20,0,20,0"
                                        VerticalAlignment="Center"
                                        Text="幅值:" />
                                    <Slider
                                        Width="200"
                                        VerticalAlignment="Center"
                                        Maximum="{Binding MaxMaginitude}"
                                        Minimum="0"
                                        Style="{StaticResource MaterialDesignDiscreteSlider}"
                                        TickFrequency="{Binding MaginitudeTick}"
                                        TickPlacement="Both"
                                        Value="{Binding MainWave.Maginitude, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="ValueChanged">
                                                <i:InvokeCommandAction Command="{Binding ExecuteCommand}" CommandParameter="条件改变" />
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                    </Slider>

                                    <TextBlock
                                        Margin="80,0,20,0"
                                        VerticalAlignment="Center"
                                        Text="相位:" />
                                    <Slider
                                        Width="200"
                                        VerticalAlignment="Center"
                                        Maximum="360"
                                        Minimum="0"
                                        Style="{StaticResource MaterialDesignDiscreteSlider}"
                                        TickFrequency="1"
                                        TickPlacement="None"
                                        Value="{Binding MainWave.Phase, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="ValueChanged">
                                                <i:InvokeCommandAction Command="{Binding ExecuteCommand}" CommandParameter="条件改变" />
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                    </Slider>
                                </StackPanel>

                            </Expander>
                            <Border Style="{StaticResource HorizontalDividerBorder}" />
                            <Expander HorizontalAlignment="Stretch">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontSize="17" Text="第二波形配置" />
                                        <ToggleButton
                                            Margin="20,0,0,0"
                                            IsChecked="{Binding SecondWave.IsEnable}"
                                            Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                            ToolTip="是否启用" />

                                        <ToggleButton
                                            Margin="20,0,0,0"
                                            IsChecked="{Binding SecondWave.IsVisible}"
                                            Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                            ToolTip="显示波形">
                                            <materialDesign:PackIcon Kind="Pin" RenderTransformOrigin=".5,.5">
                                                <materialDesign:PackIcon.RenderTransform>
                                                    <RotateTransform Angle="45" />
                                                </materialDesign:PackIcon.RenderTransform>
                                            </materialDesign:PackIcon>
                                            <materialDesign:ToggleButtonAssist.OnContent>
                                                <materialDesign:PackIcon Kind="Pin" />
                                            </materialDesign:ToggleButtonAssist.OnContent>
                                        </ToggleButton>

                                    </StackPanel>
                                </Expander.Header>

                                <StackPanel Margin="5" Orientation="Horizontal">

                                    <TextBox
                                        MinWidth="50"
                                        Margin="20,0,20,0"
                                        VerticalAlignment="Center"
                                        materialDesign:HintAssist.Hint="频率"
                                        materialDesign:TextFieldAssist.SuffixText="Hz"
                                        Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                        Text="{Binding SecondWave.Frequency, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NullableDecimalConverter}}" />

                                    <TextBlock
                                        Margin="20,0,20,0"
                                        VerticalAlignment="Center"
                                        Text="幅值:" />
                                    <Slider
                                        Width="200"
                                        VerticalAlignment="Center"
                                        Maximum="{Binding MaxMaginitude}"
                                        Minimum="0"
                                        Style="{StaticResource MaterialDesignDiscreteSlider}"
                                        TickFrequency="{Binding MaginitudeTick}"
                                        TickPlacement="Both"
                                        Value="{Binding SecondWave.Maginitude, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="ValueChanged">
                                                <i:InvokeCommandAction Command="{Binding ExecuteCommand}" CommandParameter="条件改变" />
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                    </Slider>

                                    <TextBlock
                                        Margin="80,0,20,0"
                                        VerticalAlignment="Center"
                                        Text="相位:" />
                                    <Slider
                                        Width="200"
                                        VerticalAlignment="Center"
                                        Maximum="360"
                                        Minimum="0"
                                        Style="{StaticResource MaterialDesignDiscreteSlider}"
                                        TickFrequency="1"
                                        TickPlacement="None"
                                        Value="{Binding SecondWave.Phase, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="ValueChanged">
                                                <i:InvokeCommandAction Command="{Binding ExecuteCommand}" CommandParameter="条件改变" />
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                    </Slider>
                                </StackPanel>


                            </Expander>
                            <Border Style="{StaticResource HorizontalDividerBorder}" />
                            <Expander HorizontalAlignment="Stretch">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontSize="17" Text="第三波形配置" />
                                        <ToggleButton
                                            Margin="20,0,0,0"
                                            IsChecked="{Binding ThirdWave.IsEnable}"
                                            Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                            ToolTip="是否启用" />
                                        <ToggleButton
                                            Margin="20,0,0,0"
                                            IsChecked="{Binding ThirdWave.IsVisible}"
                                            Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                            ToolTip="显示波形">
                                            <materialDesign:PackIcon Kind="Pin" RenderTransformOrigin=".5,.5">
                                                <materialDesign:PackIcon.RenderTransform>
                                                    <RotateTransform Angle="45" />
                                                </materialDesign:PackIcon.RenderTransform>
                                            </materialDesign:PackIcon>
                                            <materialDesign:ToggleButtonAssist.OnContent>
                                                <materialDesign:PackIcon Kind="Pin" />
                                            </materialDesign:ToggleButtonAssist.OnContent>
                                        </ToggleButton>
                                    </StackPanel>
                                </Expander.Header>
                                <StackPanel Margin="5" Orientation="Horizontal">

                                    <TextBox
                                        MinWidth="50"
                                        Margin="20,0,20,0"
                                        VerticalAlignment="Center"
                                        materialDesign:HintAssist.Hint="频率"
                                        materialDesign:TextFieldAssist.SuffixText="Hz"
                                        Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                        Text="{Binding ThirdWave.Frequency, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NullableDecimalConverter}}" />

                                    <TextBlock
                                        Margin="20,0,20,0"
                                        VerticalAlignment="Center"
                                        Text="幅值:" />
                                    <Slider
                                        Width="200"
                                        VerticalAlignment="Center"
                                        Maximum="{Binding MaxMaginitude}"
                                        Minimum="0"
                                        Style="{StaticResource MaterialDesignDiscreteSlider}"
                                        TickFrequency="{Binding MaginitudeTick}"
                                        TickPlacement="Both"
                                        Value="{Binding ThirdWave.Maginitude, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="ValueChanged">
                                                <i:InvokeCommandAction Command="{Binding ExecuteCommand}" CommandParameter="条件改变" />
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                    </Slider>

                                    <TextBlock
                                        Margin="80,0,20,0"
                                        VerticalAlignment="Center"
                                        Text="相位:" />
                                    <Slider
                                        Width="200"
                                        VerticalAlignment="Center"
                                        Maximum="360"
                                        Minimum="0"
                                        Style="{StaticResource MaterialDesignDiscreteSlider}"
                                        TickFrequency="1"
                                        TickPlacement="None"
                                        Value="{Binding ThirdWave.Phase, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="ValueChanged">
                                                <i:InvokeCommandAction Command="{Binding ExecuteCommand}" CommandParameter="条件改变" />
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                    </Slider>
                                </StackPanel>
                            </Expander>
                            <Border Style="{StaticResource HorizontalDividerBorder}" />
                            <Expander HorizontalAlignment="Stretch">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontSize="17" Text="噪音配置" />
                                        <ToggleButton
                                            Margin="20,0,0,0"
                                            IsChecked="{Binding Noisy.IsEnable}"
                                            Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                            ToolTip="是否启用" />
                                        <ToggleButton
                                            Margin="20,0,0,0"
                                            IsChecked="{Binding Noisy.IsVisible}"
                                            Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                            ToolTip="显示波形">
                                            <materialDesign:PackIcon Kind="Pin" RenderTransformOrigin=".5,.5">
                                                <materialDesign:PackIcon.RenderTransform>
                                                    <RotateTransform Angle="45" />
                                                </materialDesign:PackIcon.RenderTransform>
                                            </materialDesign:PackIcon>
                                            <materialDesign:ToggleButtonAssist.OnContent>
                                                <materialDesign:PackIcon Kind="Pin" />
                                            </materialDesign:ToggleButtonAssist.OnContent>
                                        </ToggleButton>
                                    </StackPanel>
                                </Expander.Header>
                                <StackPanel Margin="5" Orientation="Horizontal">
                                    <TextBox
                                        MinWidth="50"
                                        Margin="20,0,20,0"
                                        VerticalAlignment="Center"
                                        materialDesign:HintAssist.Hint="标准偏差"
                                        Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                        Text="{Binding Noisy.StdDev, Converter={StaticResource NullableDecimalConverter}}">
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="TextChanged">
                                                <i:InvokeCommandAction Command="{Binding ExecuteCommand}" CommandParameter="条件改变" />
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                    </TextBox>

                                </StackPanel>
                            </Expander>


                        </StackPanel>
                    </Expander>




                </StackPanel>

            </Grid>
        </materialDesign:Card>
        <ContentControl
            Grid.Row="1"
            Content="{Binding scottplot}"
            TextBlock.Foreground="{DynamicResource PrimaryHueMidForegroundBrush}" />

    </Grid>


</UserControl>
