<UserControl
    x:Class="wpfApp.Views.TabStatusView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:wpfApp.Common.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ext="clr-namespace:wpfApp.Extensions"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:wpfApp.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:validrule="clr-namespace:wpfApp.Common.ValidationRules"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Vertical">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <materialDesign:PackIcon
                        Width="20"
                        Height="20"
                        Margin="30,0,0,0"
                        VerticalAlignment="Center"
                        Kind="InformationVariantCircleOutline" />
                    <TextBlock
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="16"
                        Text="设备信息:" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button
                        Margin="10,0,0,0"
                        Command="{Binding ExecuteCommand}"
                        CommandParameter="清空异常"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        ToolTip="清空设备错误异常状态">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon
                                Width="20"
                                Height="20"
                                Kind="Autorenew" />
                            <TextBlock
                                Margin="5,0,0,0"
                                FontSize="16"
                                Text="清空异常" />
                        </StackPanel>
                    </Button>

                    <Button
                        Margin="10,0,10,0"
                        Command="{Binding ExecuteCommand}"
                        CommandParameter="自动搜索设备"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        ToolTip="自动查找可用设备">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon
                                Width="20"
                                Height="20"
                                Kind="Magnify" />
                            <TextBlock
                                Margin="5,0,0,0"
                                FontSize="16"
                                Text="查找刷新设备" />
                        </StackPanel>
                    </Button>
                </StackPanel>


            </DockPanel>

            <Border Margin="5,5,5,5" Style="{StaticResource HorizontalDividerBorder}" />
        </StackPanel>

        <StackPanel
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Orientation="Vertical"
            Visibility="{Binding TipVisibility}">
            <Image
                Width="200"
                Height="200"
                Margin="0,100,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                RenderOptions.BitmapScalingMode="HighQuality"
                Source="/Assets/Images/Dev.png" />
            <TextBlock
                Margin="10"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="24"
                Text="设备列表为空，请添加设备！" />
            <!--<ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <RichTextBox>
                    <FlowDocument>
                        <Paragraph>
                            这是一个很长的文本，用于演示如何在TextBlock中实现滚动效果。这是一个很长的文本，用于演示如何在TextBlock中实现滚动效果。这是一个很长的文本，用于演示如何在TextBlock中实现滚动效果。
                        </Paragraph>
                    </FlowDocument>
                </RichTextBox>
            </ScrollViewer>-->

        </StackPanel>



        <ScrollViewer
            Grid.Row="2"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">

            <ItemsControl ItemsSource="{Binding DevParaShow}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <materialDesign:Card
                            x:Name="GridMain"
                            Grid.Column="0"
                            Margin="10,15,10,10"
                            UniformCornerRadius="5"
                            Visibility="{Binding Visibility}">
                            <Grid>
                                <StackPanel Margin="15,5,15,0">

                                    <TextBlock
                                        Margin="0,0,0,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        FontSize="20"
                                        Text="{Binding Title}"
                                        TextWrapping="Wrap" />
                                    <Border Style="{StaticResource HorizontalDividerBorder}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="auto" />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Margin="10,5,10,5"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            FontSize="18"
                                            Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                            Text="测量参数"
                                            TextWrapping="Wrap" />
                                        <ItemsControl Grid.Column="1" ItemsSource="{Binding MeasurePara}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel MinWidth="280" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,10,0,10" Orientation="Horizontal">
                                                        <TextBlock
                                                            MinWidth="200"
                                                            Margin="0,0,10,0"
                                                            HorizontalAlignment="Right"
                                                            FontSize="18"
                                                            Text="{Binding Name}"
                                                            TextAlignment="Right" />
                                                        <TextBlock
                                                            HorizontalAlignment="Left"
                                                            FontSize="18"
                                                            Text="{Binding Vaule}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                    </Grid>
                                    <Border Style="{StaticResource HorizontalDividerBorder}" />


                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="auto" />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Margin="10,5,10,5"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            FontSize="18"
                                            Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                            Text="设定参数"
                                            TextWrapping="Wrap" />
                                        <ItemsControl Grid.Column="1" ItemsSource="{Binding SettingPara}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel MinWidth="280" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,10,0,10" Orientation="Horizontal">
                                                        <TextBlock
                                                            MinWidth="200"
                                                            Margin="0,0,10,0"
                                                            HorizontalAlignment="Right"
                                                            FontSize="18"
                                                            Text="{Binding Name}"
                                                            TextAlignment="Right" />
                                                        <TextBlock
                                                            HorizontalAlignment="Left"
                                                            FontSize="18"
                                                            Text="{Binding Vaule}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>

                                    <Border Style="{StaticResource HorizontalDividerBorder}" />


                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="auto" />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Margin="10,5,10,5"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            FontSize="18"
                                            Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                            Text="状态信息"
                                            TextWrapping="Wrap" />
                                        <ItemsControl Grid.Column="1" ItemsSource="{Binding StatusPara}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel MinWidth="280" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,10,0,10" Orientation="Horizontal">
                                                        <TextBlock
                                                            MinWidth="200"
                                                            Margin="0,0,10,0"
                                                            HorizontalAlignment="Right"
                                                            FontSize="18"
                                                            Text="{Binding Name}"
                                                            TextAlignment="Right" />
                                                        <TextBlock
                                                            HorizontalAlignment="Left"
                                                            FontSize="18"
                                                            Text="{Binding Vaule}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>



                                </StackPanel>
                            </Grid>
                        </materialDesign:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>


        </ScrollViewer>

    </Grid>


</UserControl>
