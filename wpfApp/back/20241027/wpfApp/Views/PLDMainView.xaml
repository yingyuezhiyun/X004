                                            Text="{Binding SettingParams.CalibPD.K}" />
                                    </StackPanel>
                                    <StackPanel
                                        Margin="5,10,0,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">
                                        <TextBlock
                                            MinWidth="100"
                                            VerticalAlignment="Center"
                                            FontWeight="Bold"
                                            Text="B" />
                                        <TextBlock
                                            MinWidth="50"
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center"
                                            Text="{Binding SettingParams.CalibPD.B}" />
                                        <TextBox
                                            Width="70"
                                            Margin="10,0,0,0"
                                            Text="{Binding SettingParams.CalibPD.B}" />
                                    </StackPanel>
                                    <Button
                                        Height="25"
                                        Margin="0,15,0,0"
                                        Command="{Binding ExecuteCommand}"
                                        CommandParameter="设置PDKB"
                                        Content="设置"
                                        Cursor="Hand" />
                                </StackPanel>
                                <Border Margin="5,15,5,5" Style="{StaticResource HorizontalDividerBorder}" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>


                    <TabItem Width="40" Height="auto">
                        <TabItem.Header>
                            <TextBlock
                                Margin="0,10,0,10"
                                HorizontalAlignment="Center"
                                RenderTransformOrigin=".5,.5"
                                Text="其他">
                                <TextBlock.LayoutTransform>
                                    <RotateTransform Angle="90" />
                                </TextBlock.LayoutTransform>
                            </TextBlock>
                        </TabItem.Header>
                        <!--<ScrollViewer
                            Margin="0,10,10,0"
                            HorizontalAlignment="Center"
                            VerticalScrollBarVisibility="Auto">-->
                        <StackPanel IsEnabled="{Binding DeviceIsOpen}">
                            <DockPanel LastChildFill="False">
                                <materialDesign:PackIcon
                                    Width="20"
                                    Height="20"
                                    Margin="10,0,10,0"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                    Kind="CogSync" />

                                <TextBlock
                                    Margin="0,0,10,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="16"
                                    Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                    Text="数据存储" />
                            </DockPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    Grid.Column="0"
                                    MinWidth="160"
                                    Margin="5,0,0,0"
                                    VerticalAlignment="Center"
                                    materialDesign:HintAssist.Hint="文件根目录"
                                    DockPanel.Dock="Left"
                                    Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                    Text="{Binding FileSavePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <StackPanel
                                    Grid.Column="1"
                                    DockPanel.Dock="Right"
                                    Orientation="Horizontal">
                                    <Button
                                        VerticalAlignment="Bottom"
                                        Command="{Binding ExecuteCommand}"
                                        CommandParameter="设置目录"
                                        Style="{StaticResource MaterialDesignToolButton}"
                                        ToolTip="设置文件根目录">
                                        <materialDesign:PackIcon Kind="FolderEditOutline" />
                                    </Button>
                                    <Button
                                        Margin="0,0,0,0"
                                        VerticalAlignment="Bottom"
                                        Command="{Binding ExecuteCommand}"
                                        CommandParameter="打开目录"
                                        Style="{StaticResource MaterialDesignToolButton}"
                                        ToolTip="打开文件根目录">
                                        <materialDesign:PackIcon Kind="Share" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <Border Margin="5,15,5,5" Style="{StaticResource HorizontalDividerBorder}" />

                            <DockPanel LastChildFill="False">
                                <materialDesign:PackIcon
                                    Width="20"
                                    Height="20"
                                    Margin="10,0,10,0"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                    Kind="CogSync" />

                                <TextBlock
                                    Margin="0,0,10,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="16"
                                    Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                    Text="固件信息" />
                            </DockPanel>

                            <StackPanel
                                Margin="5,10,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <TextBlock
                                    MinWidth="100"
                                    VerticalAlignment="Center"
                                    FontWeight="Bold"
                                    Text="当前固件版本:" />
                                <TextBlock
                                    MinWidth="50"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    Text="{Binding Update.Version}" />
                            </StackPanel>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    Grid.Column="0"
                                    MinWidth="160"
                                    Margin="5,0,0,0"
                                    VerticalAlignment="Center"
                                    materialDesign:HintAssist.Hint="选择升级文件"
                                    DockPanel.Dock="Left"
                                    Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                    Text="{Binding Update.FilePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <StackPanel
                                    Grid.Column="1"
                                    DockPanel.Dock="Right"
                                    Orientation="Horizontal">
                                    <Button
                                        VerticalAlignment="Bottom"
                                        Command="{Binding ExecuteCommand}"
                                        CommandParameter="选择升级文件"
                                        Style="{StaticResource MaterialDesignToolButton}"
                                        ToolTip="选择升级文件">
                                        <materialDesign:PackIcon Kind="FolderEditOutline" />
                                    </Button>
                                    <Button
                                        Margin="0,0,0,0"
                                        VerticalAlignment="Bottom"
                                        Command="{Binding ExecuteCommand}"
                                        CommandParameter="打开升级文件目录"
                                        Style="{StaticResource MaterialDesignToolButton}"
                                        ToolTip="打开升级文件所在目录">
                                        <materialDesign:PackIcon Kind="Share" />
                                    </Button>
                                </StackPanel>
                            </Grid>


                            <Button
                                Height="25"
                                Margin="5,5,5,5"
                                materialDesign:ButtonProgressAssist.IsIndeterminate="True"
                                materialDesign:ButtonProgressAssist.IsIndicatorVisible="{Binding Update.IsUpdate}"
                                materialDesign:ButtonProgressAssist.Value="-1"
                                Command="{Binding ExecuteCommand}"
                                CommandParameter="升级"
                                Content="{Binding Update.ButtonContent}"
                                Cursor="Hand" />

                            <Border Margin="5,15,5,5" Style="{StaticResource HorizontalDividerBorder}" />

                            <Button
                                Height="25"
                                Margin="5,5,5,5"
                                Command="{Binding ExecuteCommand}"
                                CommandParameter="清空错误"
                                Content="清空错误"
                                Cursor="Hand" />

                        </StackPanel>


                        <!--</ScrollViewer>-->
                    </TabItem>
                </TabControl>


            </materialDesign:Card>

        </Grid>

        <materialDesign:Card
            x:Name="GridMain"
            Grid.Row="1"
            Margin="5"
            UniformCornerRadius="20">
            <DockPanel Margin="15,5,15,0" LastChildFill="False">
                <StackPanel
                    Margin="0,10,0,10"
                    DockPanel.Dock="Left"
                    Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,10,0"
                        HorizontalAlignment="Right"
                        FontSize="18"
                        Text="连接状态:"
                        TextAlignment="Right" />
                    <TextBlock
                        HorizontalAlignment="Left"
                        FontSize="18"
                        Text="{Binding MeasureParams.StatusInfo.ConnectStatus.Value}" />
                </StackPanel>

                <StackPanel
                    Margin="0,10,0,10"
                    DockPanel.Dock="Right"
                    Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,10,0"
                        HorizontalAlignment="Right"
                        FontSize="18"
                        Text="自检信息:"
                        TextAlignment="Right" />
                    <TextBlock
                        HorizontalAlignment="Left"
                        FontSize="18"
                        Text="{Binding MeasureParams.StatusInfo.BITStatus.Value}" />
                </StackPanel>
            </DockPanel>
            <!--<Grid Margin="15,5,15,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Margin="10,5,10,5"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            FontSize="18"
                            Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                            Text="模式信息"
                            TextWrapping="Wrap" />
                        <ItemsControl Grid.Column="1" ItemsSource="{Binding DevParaShow.SysStatus}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel MinWidth="280" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,10,0,10" Orientation="Horizontal">
                                        <TextBlock
                                            MinWidth="200"
                                            Margin="0,0,10,0"
                                            HorizontalAlignment="Right"
                                            FontSize="18"
                                            Text="{Binding Name}"
                                            TextAlignment="Right" />
                                        <TextBlock
                                            HorizontalAlignment="Left"
                                            FontSize="18"
                                            Text="{Binding Vaule}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>-->

        </materialDesign:Card>

    </Grid>
</UserControl>
