<UserControl
    x:Class="wpfApp.Views.PLDChartView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
    xmlns:converters="clr-namespace:wpfApp.Common.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ext="clr-namespace:wpfApp.Extensions"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:wpfApp.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:validrule="clr-namespace:wpfApp.Common.ValidationRules"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <!--  Controls to select channels and autoscale options  -->
        <StackPanel
            Grid.Row="0"
            Margin="8"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Orientation="Horizontal">
            <TextBlock
                Margin="4,0"
                VerticalAlignment="Center"
                Text="通道1:" />
            <ComboBox
                Width="160"
                ItemsSource="{Binding SigNames}"
                SelectedIndex="{Binding SelectedSig1Index, Mode=TwoWay}" />
            <TextBlock
                Margin="12,0,4,0"
                VerticalAlignment="Center"
                Text="通道2:" />
            <ComboBox
                Width="160"
                ItemsSource="{Binding SigNames}"
                SelectedIndex="{Binding SelectedSig2Index, Mode=TwoWay}" />

            <CheckBox
                Margin="20,0"
                VerticalAlignment="Center"
                Content="自动缩放X轴"
                IsChecked="{Binding AutoScaleX, Mode=TwoWay}" />
            <CheckBox
                Margin="8,0"
                VerticalAlignment="Center"
                Content="自动缩放Y1轴"
                IsChecked="{Binding AutoScaleY1, Mode=TwoWay}" />
            <CheckBox
                Margin="8,0"
                VerticalAlignment="Center"
                Content="自动缩放Y2轴"
                IsChecked="{Binding AutoScaleY2, Mode=TwoWay}" />

            <Button
                Margin="12,0"
                Content="清空数据"
                Command="{Binding ClearDataCommand}" />
        </StackPanel>

        <ContentControl
            Grid.Row="1"
            MinWidth="800"
            MinHeight="450"
            Margin="0,0,10,0"
            Content="{Binding scottplot}"
            TextBlock.Foreground="{DynamicResource MaterialDesignBody}" />
    </Grid>
</UserControl>
