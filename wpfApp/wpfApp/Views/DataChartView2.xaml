<UserControl
    x:Class="wpfApp.Views.DataChartView2"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
    xmlns:converters="clr-namespace:wpfApp.Common.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ext="clr-namespace:wpfApp.Extensions"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:wpfApp.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:validrule="clr-namespace:wpfApp.Common.ValidationRules"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <TextBlock
            HorizontalAlignment="Center"
            FontSize="20"
            Text="{Binding DevName}" />

        <ContentControl
            Grid.Row="1"
            MinWidth="800"
            MinHeight="450"
            Margin="0,0,10,0"
            Content="{Binding scottplot}"
            TextBlock.Foreground="{DynamicResource MaterialDesignBody}">
            <!--<ContentControl.ContentTemplate>
         <DataTemplate>
             <ScottPlot:WpfPlot>
                 <ScottPlot:WpfPlot.ContextMenu>
                     <ContextMenu>
                         <MenuItem Header="123" />
                     </ContextMenu>
                 </ScottPlot:WpfPlot.ContextMenu>
             </ScottPlot:WpfPlot>
         </DataTemplate>
     </ContentControl.ContentTemplate>-->
        </ContentControl>
    </Grid>

</UserControl>
